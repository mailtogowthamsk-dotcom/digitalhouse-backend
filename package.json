{
  "name": "digital-house-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only --exit-child src/server.ts",
    "dev:media-worker": "DB_POOL_MAX=2 node --max-old-space-size=4096 ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only --exit-child src/workers/mediaWorker.ts",
    "dev:scheduler": "node --max-old-space-size=2048 ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only --exit-child src/workers/schedulerWorker.ts",
    "dev:stack": "echo 'Open two terminals: (1) npm run dev  (2) npm run dev:media-worker  — finalize polling requires the media worker'",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:media": "DB_POOL_MAX=2 node dist/workers/mediaWorker.js",
    "worker:scheduler": "node dist/workers/schedulerWorker.js",
    "generate-admin-key": "node scripts/generate-admin-key.js",
    "optimize-media": "ts-node --transpile-only scripts/optimize-existing-media.ts",
    "optimize-media:dry": "ts-node --transpile-only scripts/optimize-existing-media.ts --dry-run",
    "db:fix-indexes": "node scripts/legacy-db-guard.js scripts/fix-duplicate-indexes.js",
    "db:migrate-media": "node scripts/legacy-db-guard.js scripts/migrate-media-files-columns.js",
    "db:run-media-jobs-sql": "node scripts/legacy-db-guard.js scripts/run-media-jobs-sql.js",
    "db:migrate": "node scripts/migrate/cli.js up",
    "db:migrate:status": "node scripts/migrate/cli.js status",
    "db:migrate:down": "node scripts/migrate/cli.js down",
    "db:migrate:baseline": "node scripts/migrate/cli.js baseline",
    "db:migrate:validate": "node scripts/migrate/cli.js validate",
    "db:migrate:new": "node scripts/migrate/cli.js new",
    "db:audit:live": "node scripts/db-live-audit.js",
    "db:migrate-posts-media": "node scripts/legacy-db-guard.js scripts/migrate-posts-media-columns.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop digitalhouse-api digitalhouse-media-worker digitalhouse-scheduler",
    "pm2:logs": "pm2 logs digitalhouse-api digitalhouse-media-worker digitalhouse-scheduler --lines 100",
    "pm2:deploy": "bash deploy/pm2-deploy.sh",
    "install:deps": "bash deploy/npm-install-deps.sh",
    "verify:deploy": "node -e \"require('fs').accessSync('dist/server.js'); require('fs').accessSync('dist/workers/mediaWorker.js'); require('fs').accessSync('dist/workers/schedulerWorker.js'); require('express'); require('cors'); console.log('API + media worker + scheduler builds OK');\"",
    "db:verify-matrimony": "node scripts/verify-matrimony-schema.js",
    "db:run-matrimony-sql": "node scripts/legacy-db-guard.js scripts/run-matrimony-sql.js",
    "db:run-notifications-sql": "node scripts/legacy-db-guard.js scripts/run-notifications-migration.js",
    "db:run-matrimony-razorpay-sql": "node scripts/legacy-db-guard.js scripts/run-matrimony-razorpay-migration.js",
    "db:run-matrimony-subscription-p1-sql": "node scripts/legacy-db-guard.js scripts/run-matrimony-subscription-p1-migration.js",
    "db:run-matrimony-lifecycle-sql": "node scripts/legacy-db-guard.js scripts/run-matrimony-lifecycle-migration.js",
    "db:run-auth-google-sql": "node scripts/legacy-db-guard.js scripts/run-auth-google-migration.js",
    "db:run-jobs-phase2-sql": "node scripts/legacy-db-guard.js scripts/run-jobs-phase2-migration.js",
    "db:run-jobs-phase3-sql": "node scripts/legacy-db-guard.js scripts/run-jobs-phase3-migration.js",
    "db:run-jobs-recruitment-phase4-sql": "node scripts/legacy-db-guard.js scripts/run-jobs-recruitment-phase4-migration.js",
    "db:run-marketplace-phase1-sql": "node scripts/legacy-db-guard.js scripts/run-marketplace-phase1-migration.js",
    "db:run-marketplace-phase3-sql": "node scripts/legacy-db-guard.js scripts/run-marketplace-phase3-migration.js",
    "db:run-marketplace-polish-sql": "node scripts/legacy-db-guard.js scripts/run-marketplace-polish-sql.js",
    "db:run-helping-hands-phase1-sql": "node scripts/legacy-db-guard.js scripts/run-helping-hands-phase1-sql.js",
    "db:run-helping-hands-lifecycle-sql": "node scripts/legacy-db-guard.js scripts/run-helping-hands-lifecycle-migration.js",
    "db:run-master-data-phase1-sql": "node scripts/legacy-db-guard.js scripts/run-master-data-phase1-sql.js",
    "db:run-reports-phase1-sql": "node scripts/legacy-db-guard.js scripts/run-reports-phase1-sql.js",
    "db:run-platform-management-sql": "node scripts/legacy-db-guard.js scripts/run-platform-management-sql.js",
    "db:run-platform-business-settings-sql": "node scripts/legacy-db-guard.js scripts/run-platform-business-settings-sql.js",
    "db:run-system-scheduler-sql": "node scripts/legacy-db-guard.js scripts/run-system-scheduler-sql.js",
    "db:run-admin-users-sql": "node scripts/legacy-db-guard.js scripts/run-admin-users-sql.js",
    "db:run-post-moderation-sql": "node scripts/legacy-db-guard.js scripts/run-post-moderation-migration.js",
    "db:run-production-hardening-sql": "node scripts/legacy-db-guard.js scripts/run-production-hardening-sql.js",
    "db:run-optimization-indexes": "node scripts/legacy-db-guard.js scripts/run-db-optimization-indexes.js",
    "db:kill-idle-connections": "node scripts/kill-idle-db-connections.js",
    "db:run-explore-hashtags-sql": "node scripts/legacy-db-guard.js scripts/run-explore-hashtags-migration.js",
    "db:run-post-visibility-sql": "node scripts/legacy-db-guard.js scripts/run-post-visibility-migration.js",
    "db:run-registration-status-sql": "node scripts/legacy-db-guard.js scripts/run-registration-status-migration.js",
    "db:run-user-soft-delete-sql": "node scripts/legacy-db-guard.js scripts/run-user-soft-delete-migration.js",
    "db:run-legal-documents-sql": "node scripts/legacy-db-guard.js scripts/run-legal-documents-sql.js",
    "db:run-prominent-people-sql": "node scripts/legacy-db-guard.js scripts/run-prominent-people-sql.js",
    "db:seed-master-data": "node scripts/seed-master-data.cjs",
    "db:seed-kulams": "node scripts/seed-kulam-catalog.cjs",
    "db:backfill-master-data-users": "node scripts/backfill-master-data-users.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run tests/unit tests/controllers",
    "test:integration": "vitest run tests/integration",
    "test:e2e-marketplace": "node scripts/run-e2e-marketplace.cjs",
    "test:e2e-jobs": "node scripts/run-e2e-jobs.cjs",
    "test:e2e-helping-hands": "node scripts/run-e2e-helping-hands.cjs",
    "db:apply-changes-requested": "node scripts/legacy-db-guard.js scripts/apply-matrimony-changes-requested.js",
    "verify:health": "node scripts/verify-production-health.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^8.0.7",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "nsfwjs": "^4.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.15.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
