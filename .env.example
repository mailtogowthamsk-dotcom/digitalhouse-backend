NODE_ENV=development
PORT=4000
# When cPanel Node receives full path (not stripped by Apache proxy):
# API_BASE_PATH=/digitalhouse/backend

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_house
DB_USER=root
DB_PASSWORD=

# --- MySQL connection pool ---
# Profiles: test | 1gb (max 3) | prod16 (max 12) | prod64 (max 24)
# Or override directly: DB_POOL_MAX=4
DB_POOL_PROFILE=test
DB_POOL_MAX=3
DB_CONNECT_TIMEOUT_MS=20000
DB_SLOW_QUERY_MS=500
DB_SESSION_WAIT_TIMEOUT=120
DB_POOL_IDLE_MS=8000
DB_POOL_EVICT_MS=5000
DB_POOL_MAX_USES=750
# Temporary diagnostics — logs [MYSQL_POOL] acquire/release/waiting (disable in prod)
DB_POOL_DEBUG=false
# DB_POOL_DEBUG_INTERVAL_MS=15000
# Dev schema sync only (never DB_SYNC_ALTER in production)
# DB_SYNC=true
# DB_SYNC_ALTER=false

JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# Google Sign-In (mobile additional login — does not replace OTP)
# GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID= (alias for web client if only one is set)

OTP_HASH_PEPPER=change_me_otp_pepper
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Local only: print OTP in backend console
# LOG_OTP_FOR_DEV=true

# SMTP (transactional mail: OTP, approvals)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Digital House <no-reply@yourdomain.com>"
MAIL_FROM="Digital House <no-reply@yourdomain.com>"
SMTP_ENCRYPTION=tls
# Legacy alternative to SMTP_ENCRYPTION=ssl
# SMTP_SECURE=false

# API / HTTP
# JSON_BODY_LIMIT=4mb
# SLOW_API_MS=800
# LOG_REQUESTS=true
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Expo push (optional — improves rate limits; from expo.dev project credentials)
EXPO_ACCESS_TOKEN=

# Direct FCM (optional — for non-Expo native tokens). JSON string or file path:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Razorpay (shared by Matrimony AND Advertisement — one key pair, one webhook secret)
# Use rzp_test_* keys on staging. Never put live rzp_live_* keys on a staging host.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# Dashboard webhook URL (same handler on both paths):
#   POST {API}/payments/webhook
#   POST {API}/matrimony/payments/webhook
# Enable events: payment.captured, order.paid, payment.failed
# Headers used: x-razorpay-signature, x-razorpay-event-id
# Dev-only Matrimony subscribe/confirm (ignored in NODE_ENV=production; keep unset on staging)
# MATRIMONY_ALLOW_DEV_PAYMENTS=true

# Matrimony platform pricing (admin can also override via PUT /admin/matrimony/platform-settings)
# MATRIMONY_GOLD_PRICE_INR=999
# MATRIMONY_PLATINUM_PRICE_INR=1999
# MATRIMONY_CONTACT_REVEAL_PAISE=50000
# MATRIMONY_MONTHLY_OPEN_QUOTA=30
# MATRIMONY_PLAN_DURATION_MONTHS=12

# Admin panel (API only): set X-Admin-Key header to this value
ADMIN_API_KEY=your_admin_api_key_here

# Admin login (whitelist): comma-separated emails; single shared password
ADMIN_EMAILS=admin@digitalhouse.com
ADMIN_PASSWORD=change_me_admin_password

# Background jobs (defaults on; disable with *_ENABLED=false)
# PLATFORM_NOTIF_JOB_INTERVAL_MS=60000
# MATRIMONY_SUBSCRIPTION_JOB_INTERVAL_MS=3600000
# MATRIMONY_SUBSCRIPTION_JOB_ENABLED=true
# MARKETPLACE_EXPIRY_JOB_INTERVAL_MS=3600000
# MARKETPLACE_EXPIRY_JOB_ENABLED=true
# HELPING_HANDS_EXPIRY_JOB_INTERVAL_MS=900000
# HELPING_HANDS_EXPIRY_JOB_ENABLED=true
# Advertisement lifecycle (existing scheduler worker; default on, every 15 min)
# ADVERTISEMENT_LIFECYCLE_JOB_INTERVAL_MS=900000
# ADVERTISEMENT_LIFECYCLE_JOB_ENABLED=true

# Orphan PENDING media cleanup (R2 + media_files). Default: on, hourly, >24h old.
# MEDIA_ORPHAN_CLEANUP_ENABLED=true
# MEDIA_ORPHAN_CLEANUP_INTERVAL_MS=3600000
# MEDIA_ORPHAN_CLEANUP_HOURS=24
# MEDIA_ORPHAN_CLEANUP_BATCH=100
# MEDIA_MAX_CONCURRENT=2
# MEDIA_JOB_STALE_MS=900000
# MEDIA_PIPELINE_TIMING=true
# Local: API alone does not process uploads — also run: npm run dev:media-worker

# Messages
# THREAD_LIST_LIMIT=100

# App store listing URLs
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.your.app
# IOS_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID

# --- Media / R2 (bandwidth & cache) ---
# Signed GET lifetime (seconds). Cache TTL defaults to expiry − 5 minutes.
# R2_SIGNED_GET_EXPIRY_SEC=21600
# R2_SIGNED_URL_CACHE_MS=3300000
# Set R2_SIGNED_URL_CACHE_MS=0 to disable signed URL reuse (rollback / debug).
# Server-side FFmpeg optimize on video finalize (720p H.264/AAC + posters).
# VIDEO_OPTIMIZE_ENABLED=1

# --- Content safety (local nsfwjs; ₹0 external APIs) ---
# Fail closed: missing model / timeout / uncertain never publishes.
# MODERATION_MODEL_DIR=/var/www/digitalhouse/backend/models/nsfwjs
# MODERATION_MAX_CONCURRENCY=1
# MODERATION_MAX_IMAGE_SIZE=2000000
# MODERATION_MAX_VIDEO_DURATION=180
# MODERATION_FRAME_INTERVAL=5
# MODERATION_MAX_FRAMES=6
# MODERATION_TIMEOUT_MS=30000
# MODERATION_BLOCK_THRESHOLD=0.5
# MODERATION_REVIEW_THRESHOLD=0.2
# MODERATION_BLOCK_SEXY_THRESHOLD=0.75
# MODERATION_REVIEW_SEXY_THRESHOLD=0.5
# Install weights (not in git): bash scripts/install-moderation-model.sh

# Cloudflare R2 (private bucket; upload via pre-signed URLs only)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Public media base URL — Cloudflare custom domain fronted by media-guard.
# Example: https://media.konguvettuvagounder.com
# Do NOT set this to https://<accountid>.r2.cloudflarestorage.com (that is the private S3 API host; unsigned GETs fail with 400).
R2_CDN_PUBLIC_URL=https://media.konguvettuvagounder.com
